rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    match /households/{code} {
      // A long, random household code acts as the invite secret. Collection
      // listing is blocked so codes cannot be enumerated.
      allow list: if false;
      allow get: if signedIn();

      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds;

      // Existing members may update the shared fridge. A new member may only
      // add their own UID, after proving possession of the invite code by
      // reading this exact document.
      allow update: if isMember() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'updatedAt'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }
  }
}
